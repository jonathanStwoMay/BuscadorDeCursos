{
  "name": "jonathansrocha/buscador-cursos-alura",
  "description": "Projeto que busca os cursos no site da Alura",
  "license": "proprietary",
  "authors": [
    {
      "name": "Jonathan Silva da Rocha",
      "email": "jonathanestudante30@gmail.com"
    }
  ],
  "require": {
    "guzzlehttp/guzzle": "^7.9",
    "symfony/dom-crawler": "7.2.x-dev",
    "symfony/css-selector": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "Alura\\BuscadorDeCursos\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2",
    "squizlabs/php_codesniffer": "*",
    "phan/phan": "^5.4"
  },
  "scripts": {
    "test": "phpunit tests\\TestBuscadorDeCursos.php",
    "cs": "phpcs --standard=PSR12 src/",
    "phan": "phan --allow-polyfill-parser",
    "check": [
      "@phan",
      "@cs",
      "@test"
    ],
    "post-update-cmd": [
      "@test"
    ]
  },
  "scripts-descriptions": {
    "check": "Roda as verificações do código. PHAN, PHPCS, PHPunit"
  },
  "license": "GPL-3.0-only",
  "bin": ["vendor/bin/buscarCursos.php"]
}
